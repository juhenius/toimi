# Service config and secrets - copy to secrets.env and fill in real values
# Used by Kustomize secretGenerator to create K8s Secrets
openai-api-key=PLACEHOLDER
ha-bearer-token=PLACEHOLDER
muistio-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=muistio;Username=postgres;Password=REPLACE_ME
muistutin-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=muistutin;Username=postgres;Password=REPLACE_ME
ajastin-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=ajastin;Username=postgres;Password=REPLACE_ME
toimi-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=toimi;Username=postgres;Password=REPLACE_ME
ruutu-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=ruutu;Username=postgres;Password=REPLACE_ME
ntfy-base-url=https://ntfy.example.com
ntfy-topic=toimi
ntfy-username=PLACEHOLDER
ntfy-password=PLACEHOLDER
