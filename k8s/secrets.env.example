# Service config and secrets - copy to overlays/<env>/secrets.env and fill in real values
# Used by Kustomize secretGenerator to create K8s Secrets
openai-api-key=PLACEHOLDER
ha-bearer-token=PLACEHOLDER
muistio-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=muistio;Username=postgres;Password=changeme-in-production
muistutin-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=muistutin;Username=postgres;Password=changeme-in-production
ajastin-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=ajastin;Username=postgres;Password=changeme-in-production
toimi-connection-string=Host=postgresql.data.svc.cluster.local;Port=5432;Database=toimi;Username=postgres;Password=changeme-in-production
ntfy-base-url=http://ntfy.local
ntfy-topic=toimi
ntfy-username=PLACEHOLDER
ntfy-password=PLACEHOLDER
