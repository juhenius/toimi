# Toimi non-secret per-environment config.
# Copy to config.env (gitignored) and edit. Consumed by the setup/deploy
# scripts and rendered into manifests via: kubectl kustomize | envsubst | apply
#
# Ingress hostnames (must resolve to your cluster's Traefik entrypoint):
TOIMI_HOST=toimi.test
ADMINER_HOST=adminer.toimi.test
QDRANT_HOST=qdrant.toimi.test
# Image registry that deploy.sh pushes to and pods pull from:
IMAGE_REGISTRY=localhost:5000
# Home Assistant base URL used by the koti tool server (koti REQUIRES a
# reachable Home Assistant instance; see README):
HOMEASSISTANT_BASE_URL=http://homeassistant.local:8123
# OpenAI chat model name (not a secret; the API key stays in secrets.env):
OPENAI_MODEL=gpt-4o
